# Copy to app.env (git-ignored). Every key can also be set as an environment
# variable, which wins over this file.

ENVIRONMENT=development

# (secret) e.g. Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/azma?sslmode=require
# Local: `make devdb` prints the DSN for the embedded dev database.
DB_SOURCE=postgresql://cms:cms@localhost:55440/cms?sslmode=disable

HTTP_SERVER_ADDRESS=0.0.0.0:8080

# Apply db/migration on startup. Leave true unless migrations are run separately.
AUTO_MIGRATE=true

# Only needed if the admin UI is served from a different origin than the API.
# The Angular dev server proxies /api, so local dev does not need it.
ALLOWED_ORIGINS=

SESSION_DURATION=12h
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW=15m

# Uploaded files are written here and served at MEDIA_URL_PREFIX.
# In containers, mount a persistent volume here.
MEDIA_DIR=./media
MEDIA_URL_PREFIX=/media
MEDIA_MAX_BYTES=10485760

# Optional: serve the built Angular site from this process.
# STATIC_DIR=../dist/azma-associates/browser
STATIC_DIR=
